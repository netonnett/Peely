@using Peelyyy.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in now!";
}

<head>
    <link rel="stylesheet" href="~/Content/login.css">
</head>

<main>
    <div class="headingbox">
        <h2 class="heading" id="title">@ViewBag.Title</h2>
    </div>
    <div>
        <div>
            <section>
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div>
                <span class="heading2">Welcome back!</span>
                <br />
                <div class="heading3box">
                    <span class="heading3">Enter your details to log in</span>
                </div>
                </div>

           
            
                <div class="loginbox">
                    @Html.LabelFor(m => m.Email, new { @class = "labeltext" })
                    <div>
                        @Html.TextBoxFor(m => m.Email, new { placeholder = "example@email.com", @class = "textbox" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div>
                    @Html.LabelFor(m => m.Password, new { @class = "labeltext" })
                    <div>
                        @Html.PasswordFor(m => m.Password, new { placeholder = "password", @class = "textbox" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div>
                    <div>
                        <div class="rembox">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "remcheck remsa" })
                            @Html.LabelFor(m => m.RememberMe, new { @class = "remtext remsa" })
                        </div>
                    </div>
                </div>
                <div>
                    <div>
                        <input type="submit" value="Log in" class="logbutton" />
                    </div>
                </div>
                <p class="textnew">
                    new user? @Html.ActionLink("Register now!", "Register", new { area = "" }, new { @class = "registerlink" })
                </p>
         


                    @*  this once you have account confirmation enabled for password reset functionality
                    <p>
                        @Html.ActionLink("Forgot your password?", "ForgotPassword")
                    </p>*@
                }
            </section>
        </div>
        <hr />
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}