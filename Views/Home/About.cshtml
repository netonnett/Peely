            <span class="heading">About Peely</span>
        </div>
        <br />
        <ul class="navlist clearfix">
            <li class="navitems firstnavitem"><a href="#aboutus" class="navlinka">About us</a></li>
            <li class="navitems"><a href="#abourteam" class="navlinka">About our team</a></li>
